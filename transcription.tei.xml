        <pb n="3" facs="#f03" />
        <div n="3" type="scan" subtype="medical-case-text">
          <div type="page-face" n="right" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f03-r-c01">
              <seg type="diplomatic-text">二月而愈不異于平常一</seg>
              <note type="original-mark" n="1" rend="black">│</note>
              <note type="original-mark" n="5" rend="black">㆑</note>
              <note type="original-mark" n="6" rend="black">㆓</note>
              <note type="original-mark" n="9" rend="black">㆒</note>
              <note type="original-mark" n="10" rend="black">│</note>
            </ab>
            <ab type="column" n="2" xml:id="f03-r-c02">
              <seg type="diplomatic-text">月又少腹痛得食則嘔吐</seg>
              <note type="original-mark" n="3" rend="black">│</note>
              <note type="original-mark" n="6" rend="black">㆑</note>
              <note type="original-mark" n="9" rend="black">│</note>
            </ab>
            <ab type="column" n="3" xml:id="f03-r-c03">
              <seg type="diplomatic-text">一日吐蛔二三條醫雖施</seg>
              <note type="original-mark" n="1" rend="black">│</note>
              <note type="original-mark" n="3" rend="black">㆑</note>
              <note type="original-mark" n="5" rend="black">│</note>
              <note type="original-mark" n="6" rend="black">│</note>
              <note type="original-mark" n="9" rend="black">㆑</note>
              <note type="original-mark" n="10" rend="black">㆑</note>
            </ab>
            <ab type="column" n="4" xml:id="f03-r-c04">
              <seg type="diplomatic-text">治無寸功自仲夏至季秋</seg>
              <note type="original-mark" n="2" rend="black">㆓</note>
              <note type="original-mark" n="3" rend="black">│</note>
              <note type="original-mark" n="4" rend="black">㆒</note>
              <note type="original-mark" n="5" rend="black">㆓</note>
              <note type="original-mark" n="6" rend="black">│</note>
              <note type="original-mark" n="7" rend="black">㆒</note>
              <note type="original-mark" n="8" rend="black">㆓</note>
              <note type="original-mark" n="9" rend="black">│</note>
              <note type="original-mark" n="10" rend="black">㆒</note>
            </ab>
            <ab type="column" n="5" xml:id="f03-r-c05">
              <seg type="diplomatic-text">其塊物依然如舊且發餘</seg>
              <note type="original-mark" n="2" rend="black">│</note>
              <note type="original-mark" n="4" rend="black">│</note>
              <note type="original-mark" n="6" rend="black">㆑</note>
              <note type="original-mark" n="9" rend="black">㆓</note>
              <note type="original-mark" n="10" rend="black">│</note>
            </ab>
          </div>
          <div type="page-face" n="left" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f03-l-c01">
              <seg type="diplomatic-text">証因請予治診脈沈而細</seg>
              <note type="original-mark" n="1" rend="black">㆒</note>
              <note type="original-mark" n="3" rend="black">㆓</note>
              <note type="original-mark" n="5" rend="black">㆒</note>
              <note type="original-mark" n="10" rend="black">│</note>
            </ab>
            <ab type="column" n="2" xml:id="f03-l-c02">
              <seg type="diplomatic-text">數四肢微冷身體削瘦往</seg>
              <note type="original-mark" n="2" rend="black">│</note>
              <note type="original-mark" n="4" rend="black">│</note>
              <note type="original-mark" n="6" rend="black">│</note>
              <note type="original-mark" n="8" rend="black">│</note>
              <note type="original-mark" n="10" rend="black">│</note>
            </ab>
            <ab type="column" n="3" xml:id="f03-l-c03">
              <seg type="diplomatic-text">來寒熱咳嗽吐粘痰殆不</seg>
              <note type="original-mark" n="2" rend="black">│</note>
              <note type="original-mark" n="4" rend="black">│</note>
              <note type="original-mark" n="6" rend="black">㆓</note>
              <note type="original-mark" n="7" rend="black">│</note>
              <note type="original-mark" n="8" rend="black">㆒</note>
              <note type="original-mark" n="10" rend="black">㆑</note>
            </ab>
            <ab type="column" n="4" xml:id="f03-l-c04">
              <seg type="diplomatic-text">異于癆瘵雖然少腹焮腫</seg>
              <note type="original-mark" n="1" rend="black">㆓</note>
              <note type="original-mark" n="3" rend="black">│</note>
              <note type="original-mark" n="4" rend="black">㆒</note>
              <note type="original-mark" n="5" rend="black">㆑</note>
              <note type="original-mark" n="7" rend="black">│</note>
              <note type="original-mark" n="9" rend="black">│</note>
            </ab>
            <ab type="column" n="5" xml:id="f03-l-c05">
              <seg type="diplomatic-text">臍房突起痛楚如以鍼錐</seg>
              <note type="original-mark" n="1" rend="black">│</note>
              <note type="original-mark" n="3" rend="black">│</note>
              <note type="original-mark" n="5" rend="black">│</note>
              <note type="original-mark" n="7" rend="black">㆘</note>
              <note type="original-mark" n="8" rend="black">㆓</note>
              <note type="original-mark" n="9" rend="black">│</note>
              <note type="original-mark" n="10" rend="black">㆒</note>
            </ab>
          </div>
          <div type="editorial-observations">
            <ab type="layout">兩半葉都有墨筆漢文和返點／連字符。</ab>
          </div>
        </div>
        <pb n="4" facs="#f04" />
        <div n="4" type="scan" subtype="medical-case-text">
          <div type="page-face" n="right" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f04-r-c01">
              <seg type="diplomatic-text">刺以指頭按其腹則催膿</seg>
              <note type="original-mark" n="1" rend="black">㆖</note>
              <note type="original-mark" n="2" rend="black">㆓</note>
              <note type="original-mark" n="3" rend="black">│</note>
              <note type="original-mark" n="4" rend="black">㆒</note>
              <note type="original-mark" n="5" rend="black">㆓</note>
              <note type="original-mark" n="7" rend="black">㆒</note>
              <note type="original-mark" n="9" rend="black">㆓</note>
              <note type="original-mark" n="10" rend="black">│</note>
            </ab>
            <ab type="column" n="2" xml:id="f04-r-c02">
              <seg type="diplomatic-text">管於是去臍一寸不鍼而</seg>
              <note type="original-mark" n="1" rend="black">㆒</note>
              <note type="original-mark" n="2" rend="black">㆑</note>
              <note type="original-mark" n="4" rend="black">㆑</note>
              <note type="original-mark" n="6" rend="black">│</note>
              <note type="original-mark" n="8" rend="black">㆑</note>
            </ab>
            <ab type="column" n="3" xml:id="f04-r-c03">
              <seg type="diplomatic-text">出膿汁率可二□後從鍼</seg>
              <note type="original-mark" n="1" rend="black">㆓</note>
              <note type="original-mark" n="2" rend="black">│</note>
              <note type="original-mark" n="3" rend="black">㆒</note>
              <note type="original-mark" n="5" rend="black">㆓</note>
              <note type="original-mark" n="6" rend="black">│</note>
              <note type="original-mark" n="7" rend="black">㆒</note>
              <note type="original-mark" n="9" rend="black">㆓</note>
              <note type="original-mark" n="10" rend="black">│</note>
            </ab>
            <ab type="column" n="4" xml:id="f04-r-c04">
              <seg type="diplomatic-text">口用測瘡子探試之應手</seg>
              <note type="original-mark" n="1" rend="black">㆒</note>
              <note type="original-mark" n="2" rend="black">㆓</note>
              <note type="original-mark" n="3" rend="black">│</note>
              <note type="original-mark" n="5" rend="black">㆒</note>
              <note type="original-mark" n="6" rend="black">│</note>
              <note type="original-mark" n="6" rend="black">㆓</note>
              <note type="original-mark" n="8" rend="black">㆒</note>
              <note type="original-mark" n="9" rend="black">㆑</note>
              <note type="source-note" n="5">
                <seg type="note-line" n="1">
                  <seg type="diplomatic-text">□ン□</seg>
                </seg>
              </note>
            </ab>
            <ab type="column" n="5" xml:id="f04-r-c05">
              <seg type="diplomatic-text">如骨予曾閲西学家所譯</seg>
              <note type="original-mark" n="1" rend="black">㆑</note>
              <note type="original-mark" n="4" rend="black">㆓</note>
              <note type="original-mark" n="5" rend="black">│</note>
              <note type="original-mark" n="6" rend="black">│</note>
              <note type="original-mark" n="8" rend="black">㆑</note>
            </ab>
          </div>
          <div type="page-face" n="left" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f04-l-c01">
              <seg type="diplomatic-text">之書有宮外結胎之説因</seg>
              <note type="original-mark" n="2" rend="black">㆒</note>
              <note type="original-mark" n="3" rend="black">㆓</note>
              <note type="original-mark" n="4" rend="black">│</note>
              <note type="original-mark" n="6" rend="black">│</note>
              <note type="original-mark" n="9" rend="black">㆒</note>
            </ab>
            <ab type="column" n="2" xml:id="f04-l-c02">
              <seg type="diplomatic-text">思為腹中無有骨之理是</seg>
              <note type="original-mark" n="1" rend="black">│</note>
              <note type="original-mark" n="3" rend="black">│</note>
              <note type="original-mark" n="5" rend="black">㆓</note>
              <note type="original-mark" n="6" rend="black">㆑</note>
              <note type="original-mark" n="9" rend="black">㆒</note>
            </ab>
            <ab type="column" n="3" xml:id="f04-l-c03">
              <seg type="diplomatic-text">則胞外之妊娠也非施截</seg>
